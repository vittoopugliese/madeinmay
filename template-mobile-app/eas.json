{
  "cli": {
    "version": ">= 10.2.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_SECRET": "EXPO_PUBLIC_AUTH_SECRET"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_AUTH_SECRET": "EXPO_PUBLIC_AUTH_SECRET"
      }
    }
  },
  "submit": {
    "production": {}
  }
}